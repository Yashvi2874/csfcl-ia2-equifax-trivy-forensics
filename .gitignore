# Trivy local cache (large, machine-specific - never commit)
.trivycache/
trivy-cache/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
.idea/

# Downloaded binaries
bin/
*.exe

# Keep evidence output - it IS the deliverable
!output/
!output/**

# Convenience mirror of the newest run, rebuilt on every scan
output/latest/

# Python bytecode
__pycache__/
